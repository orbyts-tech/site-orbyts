{
  "name": "site-orbyts",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build && node -e \"const fs=require('fs'); fs.mkdirSync('public/_next/static', {recursive:true}); fs.cpSync('.next/static', 'public/_next/static', {recursive:true})\"",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run build",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "next": "^15.5.21",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
