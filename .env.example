# URLs dos sistemas ao vivo (iframe). Sobrescrevem os previews de teste.
# O app precisa permitir embed do domínio ORBYTS (CSP frame-ancestors ou sem X-Frame-Options).

# URL canônica do site (SEO, Open Graph, sitemap e JSON-LD)
# NEXT_PUBLIC_SITE_URL=https://orbytstech.com

# Verificação de propriedade — Google Search Console e Bing Webmaster Tools (só o valor do content)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# NEXT_PUBLIC_PROJECT_TRANCATTO_URL=https://trancatto-orbyts.netlify.app/
# NEXT_PUBLIC_PROJECT_NILO_URL=https://nilo-consultor-grafico.netlify.app/

# E-mail de propostas / leads — Resend (recomendado)
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# Destinatário interno (para onde chegam os leads):
# PROPOSAL_NOTIFICATION_EMAIL=comercial@orbytstech.com
#
# IMPORTANTE anti-spam: sem RESEND_FROM o site usa onboarding@resend.dev e o Gmail
# costuma mandar para spam. Faça isto uma vez:
# 1) https://resend.com/domains → Add Domain → orbytstech.com
# 2) Copie os registros DNS (SPF, DKIM, opcional DMARC) no provedor do domínio
# 3) Espere status "Verified"
# 4) Defina o remetente com o domínio verificado (prefira noreply@, não o comercial@):
# RESEND_FROM="ORBYTS <noreply@orbytstech.com>"

# Alternativa: SMTP genérico / Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua_senha_de_app
# SMTP_FROM=ORBYTS Site <seu-email@gmail.com>
